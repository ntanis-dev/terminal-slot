{
  "name": "terminal-slot",
  "version": "1.0.0",
  "packageManager": "pnpm@11.15.1",
  "description": "A terminal adaptation of Amatic's \"Hot Scatter\" slot.",
  "author": "https://github.com/ntanis-dev",
  "license": "ISC",
  "main": "index.js",
  "type": "module",
  "bin": {
    "gamba": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "release:build": "node -e \"require('node:fs').mkdirSync('ntanis-release',{recursive:true})\" && pnpm pack --pack-destination ntanis-release",
    "security:check": "node scripts/check-supply-chain.mjs",
    "security:signatures": "npm audit signatures",
    "security:vulnerabilities": "pnpm audit --audit-level high",
    "security:sbom": "pnpm sbom --prod --lockfile-only --sbom-format cyclonedx --sbom-spec-version 1.6 --sbom-type application --out terminal-slot.sbom.cdx.json"
  },
  "files": ["index.js", "README.md", "LICENSE"],
  "dependencies": {
    "chalk": "5.4.1",
    "cli-progress": "3.12.0",
    "keypress": "0.2.1"
  },
  "devDependencies": {
    "@types/keypress": "2.0.30"
  }
}
